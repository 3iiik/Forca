---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FeaturesPage } from '../../components/FeaturesPage';

const title = 'Features — Automatic focus zones, website blocking, calendar integration, and wall-clock timing';
const description = 'Explore Forca features: automatic focus activation from calendar, website blocking via DNR, multi-zone support, wall-clock accurate timers, Firefox and Chromium browser extensions, local-first architecture, and full privacy.';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Forca Features",
  "description": description,
};
---

<BaseLayout {title} {description} {structuredData}>
  <FeaturesPage client:load />
</BaseLayout>

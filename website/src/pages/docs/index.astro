---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DocsPage } from '../../components/DocsPage';

const title = 'Documentation — Installation, browser extensions, and troubleshooting';
const description = 'Comprehensive Forca documentation: getting started, desktop installation, Firefox and Chromium extension setup, how Forca works, focus sessions, system tray, troubleshooting, privacy, and FAQ.';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Forca Documentation",
  "description": description,
};
---

<BaseLayout {title} {description} {structuredData}>
  <DocsPage client:load />
</BaseLayout>
